  "info": {
    "title": "My API",
    "description": "API documentation",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "JWT-auth": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "CreateUserDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Nguyen Van A",
            "description": "Tên người dùng"
          },
          "email": {
            "type": "string",
            "example": "nguyenvana@example.com",
            "description": "Email (unique)"
          },
          "password": {
            "type": "string",
            "example": "Secret@123",
            "description": "Mật khẩu"
          },
          "role": {
            "type": "string",
            "enum": [
              "admin",
              "editor",
              "viewer"
            ],
            "default": "editor",
            "description": "Vai trò: admin | editor | viewer"
          }
        },
        "required": [
          "name",
          "email",
          "password"
        ]
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "a1b2c3d4-...",
            "description": "UUID tự sinh"
          },
          "name": {
            "type": "string",
            "example": "Nguyen Van A"
          },
          "email": {
            "type": "string",
            "example": "nguyenvana@example.com"
          },
          "googleId": {
            "type": "object",
            "example": "google-oauth2|1234567890"
          },
          "appleId": {
            "type": "object",
            "example": "apple-sub-1234567890"
          },
          "role": {
            "type": "string",
            "enum": [
              "admin",
              "editor",
              "viewer"
            ],
            "default": "editor"
          },
          "isActive": {
            "type": "boolean",
            "example": true
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "role",
          "isActive",
          "createdAt",
          "updatedAt"
        ]
      },
      "UpdateUserDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Nguyen Van B",
            "description": "Tên người dùng"
          },
          "email": {
            "type": "string",
            "example": "newmail@example.com",
            "description": "Email mới (unique)"
          },
          "password": {
            "type": "string",
            "example": "NewSecret@456",
            "description": "Mật khẩu mới"
          },
          "role": {
            "type": "string",
            "enum": [
              "admin",
              "editor",
              "viewer"
            ],
            "description": "Vai trò: admin | editor | viewer"
          },
          "isActive": {
            "type": "boolean",
            "example": true,
            "description": "Trạng thái hoạt động"
          }
        }
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Nguyen Van A",
            "minLength": 2,
            "maxLength": 100
          },
          "email": {
            "type": "string",
            "example": "user@example.com",
            "format": "email"
          },
          "password": {
            "type": "string",
            "example": "P@ssw0rd!",
            "minLength": 8,
            "description": "Tối thiểu 8 ký tự, có chữ hoa, chữ thường và số"
          },
          "role": {
            "type": "string",
            "enum": [
              "editor",
              "viewer"
            ],
            "default": "editor",
            "description": "Chỉ cho phép: editor | viewer (admin cần tạo qua /users)"
          }
        },
        "required": [
          "name",
          "email",
          "password"
        ]
      },
      "UserProfileDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "admin",
              "editor",
              "viewer"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "role"
        ]
      },
      "AuthResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "JWT access token, hết hạn sau 15 phút"
          },
          "refreshToken": {
            "type": "string",
            "description": "Refresh token, hết hạn sau 7 ngày"
          },
          "user": {
            "$ref": "#/components/schemas/UserProfileDto"
          }
        },
        "required": [
          "accessToken",
          "refreshToken",
          "user"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com",
            "format": "email"
          },
          "password": {
            "type": "string",
            "example": "P@ssw0rd!"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "description": "Refresh token nhận được khi đăng nhập"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "CreatePostDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "Tiêu đề bài viết hay",
            "description": "Tiêu đề"
          },
          "content": {
            "type": "string",
            "example": "Nội dung chi tiết bài viết...",
            "description": "Nội dung"
          },
          "slug": {
            "type": "string",
            "example": "tieu-de-bai-viet-hay",
            "description": "Slug SEO (chỉ chứa a-z, 0-9 và dấu gạch ngang)"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "published",
              "archived"
            ],
            "default": "draft",
            "description": "Trạng thái bài viết"
          }
        },
        "required": [
          "title",
          "content"
        ]
      },
      "Post": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "a1b2c3d4-...",
            "description": "UUID tự sinh"
          },
          "title": {
            "type": "string",
            "example": "Tiêu đề bài viết"
          },
          "content": {
            "type": "string",
            "example": "Nội dung bài viết..."
          },
          "slug": {
            "type": "object",
            "example": "tieu-de-bai-viet"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "published",
              "archived"
            ],
            "default": "draft"
          },
          "authorId": {
            "type": "string",
            "description": "ID của tác giả"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "content",
          "status",
          "authorId",
          "createdAt",
          "updatedAt"
        ]
      },
      "UpdatePostDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "Tiêu đề bài viết hay",
            "description": "Tiêu đề"
          },
          "content": {
            "type": "string",
            "example": "Nội dung chi tiết bài viết...",
            "description": "Nội dung"
          },
          "slug": {
            "type": "string",
            "example": "tieu-de-bai-viet-hay",
            "description": "Slug SEO (chỉ chứa a-z, 0-9 và dấu gạch ngang)"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "published",
              "archived"
            ],
            "default": "draft",
            "description": "Trạng thái bài viết"
          }
        }
      }
    }
  }
}